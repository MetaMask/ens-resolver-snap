{
  "name": "@metamask/ens-resolver-snap",
  "version": "1.1.0",
  "description": "A MetaMask Snap used for Ethereum Name Service (ENS) resolution",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/ens-resolver-snap.git"
  },
  "license": "Apache-2.0",
  "exports": {
    "./package.json": "./package.json",
    "./snap.manifest.json": "./snap.manifest.json",
    "./images/icon.svg": "./images/icon.svg",
    "./dist/bundle.js": "./dist/bundle.js",
    "./dist/preinstalled-snap.json": "./dist/preinstalled-snap.json"
  },
  "main": "dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "yarn build:snap && yarn build:types && yarn build-preinstalled-snap",
    "build-preinstalled-snap": "node scripts/build-preinstalled-snap.js",
    "build:clean": "yarn clean && yarn build",
    "build:snap": "mm-snap build",
    "build:types": "tsc",
    "clean": "rimraf ./dist",
    "lint": "yarn lint:eslint && yarn lint:constraints && yarn lint:misc --check && yarn lint:dependencies --check && yarn lint:changelog",
    "lint:changelog": "auto-changelog validate --prettier",
    "lint:constraints": "yarn constraints",
    "lint:dependencies": "depcheck && yarn dedupe --check",
    "lint:dependencies:fix": "depcheck && yarn dedupe",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:constraints --fix && yarn lint:misc --write && yarn lint:dependencies:fix && yarn lint:changelog",
    "lint:misc": "prettier '**/*.json' '**/*.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "prepack": "./scripts/prepack.sh",
    "prepublishOnly": "mm-snap manifest",
    "test": "jest"
  },
  "devDependencies": {
    "@ensdomains/address-encoder": "^1.1.4",
    "@jest/globals": "29.5.0",
    "@lavamoat/allow-scripts": "^3.0.4",
    "@lavamoat/preinstall-always-fail": "^2.0.0",
    "@metamask/auto-changelog": "^4.0.0",
    "@metamask/eslint-config": "^14.1.0",
    "@metamask/eslint-config-jest": "^14.1.0",
    "@metamask/eslint-config-nodejs": "^14.0.0",
    "@metamask/eslint-config-typescript": "^14.1.0",
    "@metamask/snaps-cli": "^8.3.0",
    "@metamask/snaps-jest": "^9.4.1",
    "@metamask/snaps-sdk": "^10.0.0",
    "@metamask/utils": "^11.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@typescript-eslint/utils": "^8.46.4",
    "depcheck": "^1.4.3",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "ethers": "^6.13.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.5.8",
    "rimraf": "3.0.2",
    "ts-jest": "29.1.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@metamask/snaps-cli>@swc/core": false,
      "eslint-plugin-import-x>unrs-resolver": false
    }
  }
}

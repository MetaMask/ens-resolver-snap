{
  "name": "@metamask/ens-resolver-snap",
  "version": "1.1.0",
  "description": "A MetaMask Snap used for Ethereum Name Service (ENS) resolution",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/ens-resolver-snap.git"
  },
  "license": "Apache-2.0",
  "exports": {
    "./package.json": "./package.json",
    "./snap.manifest.json": "./snap.manifest.json",
    "./images/icon.svg": "./images/icon.svg",
    "./dist/bundle.js": "./dist/bundle.js",
    "./dist/preinstalled-snap.json": "./dist/preinstalled-snap.json"
  },
  "main": "dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "yarn build:snap && yarn build:types && yarn build-preinstalled-snap",
    "build-preinstalled-snap": "node scripts/build-preinstalled-snap.js",
    "build:clean": "yarn clean && yarn build",
    "build:snap": "mm-snap build",
    "build:types": "tsc",
    "clean": "rimraf ./dist",
    "lint": "yarn lint:eslint && yarn lint:misc --check",
    "lint:eslint": "eslint ./ --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!CHANGELOG.md' --ignore-path .gitignore",
    "prepublishOnly": "mm-snap manifest",
    "test": "jest"
  },
  "devDependencies": {
    "@ensdomains/address-encoder": "^1.1.4",
    "@jest/globals": "29.5.0",
    "@lavamoat/allow-scripts": "3.0.4",
    "@lavamoat/preinstall-always-fail": "2.0.0",
    "@metamask/auto-changelog": "3.4.4",
    "@metamask/eslint-config": "^15.0.0",
    "@metamask/eslint-config-jest": "^15.0.0",
    "@metamask/eslint-config-nodejs": "^15.0.0",
    "@metamask/eslint-config-typescript": "^15.0.0",
    "@metamask/snaps-cli": "^8.3.0",
    "@metamask/snaps-jest": "^9.4.1",
    "@metamask/snaps-sdk": "^10.0.0",
    "@metamask/utils": "^11.8.1",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "ethers": "^6.13.1",
    "jest": "29.5.0",
    "prettier": "^3.8.3",
    "prettier-2": "npm:prettier@^2.8.8",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "3.0.2",
    "sharp": "0.32.6",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.1"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=18.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "sharp": true,
      "@metamask/snaps-cli>@swc/core": false,
      "eslint-plugin-import-x>unrs-resolver": false
    }
  }
}
